{
  "_comment": "Enhanced Configuration for Better Performance",

  "building": "OfficeSmall",
  "weather": "Hot_Dry",
  "location": "Tucson",

  "base_dir": "./pipeline_output",

  "ppo_total_steps": 500000,
  "ppo_checkpoint_freq": 50000,

  "_comment_fewshot": "Increased expert examples: 20 clusters × 30 = 600 samples",
  "preselect": 3000,
  "clusters": 20,
  "n_per_cluster": 30,
  "min_reward_percentile": 0.5,

  "_comment_llm": "LLM rollout configuration - 50 episodes for more training data",
  "llm_rollout_episodes": 50,
  "llm_rollout_max_steps": 200,
  "model_name": "Qwen/Qwen2.5-7B-Instruct",
  "temperature": 0.7,
  "k_fewshot": 5,
  "fewshot_alpha": 0.6,

  "_comment_finetune": "Progressive on-policy training with data refresh",
  "finetune_epochs": 4,
  "finetune_lr": 1e-5,
  "finetune_batch_size": 1,
  "finetune_grad_accum": 8,

  "_comment_progressive": "Progressive on-policy: gradually transition from offline to on-policy",
  "use_progressive_onpolicy": true,
  "refresh_schedule": [
    {"after_epoch": 1, "new_episodes": 10, "keep_old_episodes": 50, "new_data_weight": 2.0, "clip_eps": 0.18},
    {"after_epoch": 2, "new_episodes": 10, "keep_old_episodes": 10, "new_data_weight": 1.5, "clip_eps": 0.15},
    {"after_epoch": 3, "new_episodes": 5, "keep_old_episodes": 5, "new_data_weight": 1.0, "clip_eps": 0.12}
  ],
  "initial_clip_eps": 0.20,

  "eval_episodes": 20,

  "_comment_backup": "Google Drive backup",
  "drive_backup_path": "/content/drive/MyDrive/HVAC-RL-Backup",
  "resume_from_backup": true,

  "_comment_future": "Future enhancement: iterative_rounds for self-improvement loop"
}
